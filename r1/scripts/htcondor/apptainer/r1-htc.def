Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-rockylinux9

# Paper B R1 HTCondor image, Apptainer route (author instruction 14 Nov 2026, S3).
# Contents per HTCONDOR_PREP_RUNBOOK_20261114.md §3 (three pinned uv environments + llama.cpp
# 620d2225 built for CUDA arch 70;80;89;90). Build inputs are the committed lock/freeze files
# beside this def; the harness lock is the one at harness commit a3fedbb (env 1), the 65-package
# freeze is TRACKS_HOST_FACTS_20261030 §0.5 sha f1c818e5… (env 2), and the Track P freeze is
# docs/r1/overnight/trackp_code_20261026/pip_freeze_trackp-cpu.txt (env 3).
# No network access is needed at job time: every environment is built at image-build time.
# No code checkouts, models, data or credentials are in the image.

%files
    uv.lock.a3fedbb /opt/r1/harness/uv.lock
    pyproject.toml.a3fedbb /opt/r1/harness/pyproject.toml
    tracks_freeze_65.txt /opt/r1/locks/tracks_freeze_65.txt
    pip_freeze_trackp-cpu.txt /opt/r1/locks/pip_freeze_trackp-cpu.txt

%post
    set -eux
    # Basic tools (runbook §3): git, rsync, jq, xrootd-client; build tooling for llama.cpp.
    dnf install -y --setopt=install_weak_deps=False \
        git rsync jq xrootd-client gcc gcc-c++ make cmake tar gzip curl findutils which procps-ng
    dnf clean all

    # uv pinned to 0.13.6 (TRACKS_HOST_FACTS_20261030 §0.5).
    export UV_INSTALL_DIR=/opt/uv
    curl -LsSf https://astral.sh/uv/0.13.6/install.sh | sh
    export PATH=/opt/uv:$PATH
    export UV_PYTHON_INSTALL_DIR=/opt/r1/pythons
    mkdir -p /opt/r1/envs /opt/r1/pythons /opt/r1/harness /opt/r1/locks
    uv python install 3.13 3.11

    # Env 1 — harness: uv.lock at harness a3fedbb (Python 3.13; NumPy 2.4.4 per the lock).
    cd /opt/r1/harness
    uv sync --frozen --no-dev --python 3.13
    mv /opt/r1/harness/.venv /opt/r1/envs/harness

    # Env 2 — Track S/Track P: the 65-package freeze (Python 3.11; sha256 f1c818e5…).
    uv venv --python 3.11 /opt/r1/envs/tracks
    uv pip install --python /opt/r1/envs/tracks/bin/python -r /opt/r1/locks/tracks_freeze_65.txt

    # Env 3 — Track P training: pip_freeze_trackp-cpu.txt (Python 3.13) with the matching CUDA
    # torch build instead of its CPU wheel. No cu124 wheel version is pinned anywhere, so the
    # choice is recorded as proposed: torch 2.14.1 from the cu124 index, falling back to the
    # newest cu124 wheel if that exact build is not published; the fallback is written to
    # /opt/r1/VERSIONS.txt and must be replaced by an author ruling before production use.
    uv venv --python 3.13 /opt/r1/envs/trackp
    grep -viE '^torch(==|@| )' /opt/r1/locks/pip_freeze_trackp-cpu.txt > /tmp/trackp_no_torch.txt
    uv pip install --python /opt/r1/envs/trackp/bin/python -r /tmp/trackp_no_torch.txt
    if uv pip install --python /opt/r1/envs/trackp/bin/python \
            --index-url https://download.pytorch.org/whl/cu124 'torch==2.14.1'; then
        TORCH_PIN="torch==2.14.1 (cu124, proposed)"
    else
        uv pip install --python /opt/r1/envs/trackp/bin/python \
            --index-url https://download.pytorch.org/whl/cu124 torch
        TORCH_PIN="$(/opt/r1/envs/trackp/bin/python -c 'import torch; print("torch=="+torch.__version__+" (cu124 index, fallback, proposed)")')"
    fi

    # llama.cpp at the pinned commit, CUDA build for V100, A100, L40S/4090, H200.
    git clone https://github.com/ggml-org/llama.cpp /opt/r1/llama.cpp
    git -C /opt/r1/llama.cpp checkout 620d2225cc436ab0b001e3200e590e3b286ef9ab
    cmake -S /opt/r1/llama.cpp -B /opt/r1/llama.cpp/build \
        -DGGML_CUDA=ON -DGGML_NATIVE=OFF -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="70;80;89;90"
    cmake --build /opt/r1/llama.cpp/build -j"$(nproc)" --target llama-server
    sha256sum /opt/r1/llama.cpp/build/bin/llama-server > /opt/r1/LLAMA_SERVER_SHA256
    git -C /opt/r1/llama.cpp rev-parse HEAD > /opt/r1/LLAMA_CPP_COMMIT

    # Version record, so a job can print everything in one go.
    {
        echo "base=nvidia/cuda:12.4.1-cudnn-devel-rockylinux9"
        echo "uv=$(uv --version)"
        echo "python_313=$(/opt/r1/envs/harness/bin/python -VV 2>&1)"
        echo "python_311=$(/opt/r1/envs/tracks/bin/python -VV 2>&1)"
        echo "python_trackp=$(/opt/r1/envs/trackp/bin/python -VV 2>&1)"
        echo "torch_pin=$TORCH_PIN"
        echo "torch_actual=$(/opt/r1/envs/trackp/bin/python -c 'import torch; print(torch.__version__)')"
        echo "llama_cpp_commit=$(cat /opt/r1/LLAMA_CPP_COMMIT)"
        echo "llama_server_sha256=$(awk '{print $1}' /opt/r1/LLAMA_SERVER_SHA256)"
        echo "harness_lock_sha256=$(sha256sum /opt/r1/harness/uv.lock | awk '{print $1}')"
        echo "tracks_freeze_sha256=$(sha256sum /opt/r1/locks/tracks_freeze_65.txt | awk '{print $1}')"
        echo "trackp_freeze_sha256=$(sha256sum /opt/r1/locks/pip_freeze_trackp-cpu.txt | awk '{print $1}')"
    } > /opt/r1/VERSIONS.txt

%environment
    export PATH=/opt/uv:/opt/r1/llama.cpp/build/bin:$PATH
    export UV_PYTHON_INSTALL_DIR=/opt/r1/pythons

%labels
    r1.paper R1
    r1.base nvidia/cuda:12.4.1-cudnn-devel-rockylinux9
    r1.envs /opt/r1/envs/{harness,tracks,trackp}
    r1.llama_cpp 620d2225cc436ab0b001e3200e590e3b286ef9ab

%help
    Paper B R1 HTCondor image (Apptainer route). Contains:
      /opt/r1/envs/harness  Python 3.13, harness uv.lock @ a3fedbb
      /opt/r1/envs/tracks   Python 3.11, 65-package freeze (sha f1c818e5…)
      /opt/r1/envs/trackp   Python 3.13, Track P freeze + CUDA torch (proposed)
      /opt/r1/llama.cpp     llama.cpp @ 620d2225, CUDA arch 70;80;89;90
      /opt/r1/VERSIONS.txt  all version/sha records
    Build: apptainer build r1-htc-20261114.sif r1-htc.def
