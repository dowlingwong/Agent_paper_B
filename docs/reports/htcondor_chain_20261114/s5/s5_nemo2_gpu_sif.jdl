universe = container
container_image = /work/dwong/paperb/images/r1-htc-20261114.sif
executable = s5_run.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = s5_run.sh
transfer_output_files = s5_identity.txt, s5_env.txt, s5_nvidia.txt, s5_torch.txt, s5_llama.txt
+RequestWalltime = 1800
RequestCPUs = 2
RequestMemory = 4000
request_disk = 5000000
request_GPUs = 1
+RemoteJob = True
requirements = (TARGET.CloudSite =?= "BwForCluster-Nemo2") && (TARGET.GPUs_DeviceName =?= "NVIDIA L40S")
queue 1
