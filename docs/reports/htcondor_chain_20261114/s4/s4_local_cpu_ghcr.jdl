universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-cpu@sha256:221ca459d62723ec58219c37c71e1664846b135ff919ec59cf37ce57158f75aa
executable = s4_run.sh
arguments = "$(ClusterId).$(ProcId)"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = s4_run.sh
output = s4.out
error = s4.err
log = s4.log
+RequestWalltime = 3600
RequestCPUs = 2
RequestMemory = 8000
request_disk = 30000000
requirements = TARGET.ProvidesETPResources
queue 1
