universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:b1144ecec7ffe07642ff108fb9624aa34775cb873ed17f835ea3e3c87bc024fd
executable = probe.sh
arguments = $(ClusterId).$(ProcId)
requirements = (TARGET.CloudSite =?= "BwForCluster-Nemo2") && (TARGET.GPUs_DeviceName =?= "NVIDIA H200")
+RemoteJob = True
request_GPUs = 1
request_cpus = 4
request_memory = 16000
request_disk = 35000000
+RequestWalltime = 3600
periodic_hold = (NumJobStarts > 1)
job_machine_attrs = CloudSite
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
output = probe.out
error = probe.err
log = probe.log
transfer_input_files = nvidia-smi-scoped,probe_mode.txt,registry.yaml,stage_models.py,tasl7_smoke_reference.json
transfer_output_files = handback
queue 1
