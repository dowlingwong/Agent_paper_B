universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-cpu@sha256:08a36eff19718b439574829e37c84b865c7df74a1e12fba5228cd06236d7a5bb
executable = s4_run.sh
arguments = "$(ClusterId).$(ProcId)"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = s4_run.sh
output = s4.out
error = s4.err
log = s4.log
+RequestWalltime = 3600
RequestCPUs = 2
RequestMemory = 8000
request_disk = 30000000
requirements = TARGET.ProvidesETPResources
queue 1
