universe = docker
docker_image = cverstege/alma9-gridjob
executable = probe.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = probe.sh
+RequestWalltime = 1800
arguments = P5
output = P5.out
error = P5.err
log = P5.log
RequestCPUs = 2
RequestMemory = 4000
request_disk = 5000000
request_GPUs = 1
+RemoteJob = True
requirements = TARGET.GPUs_DeviceName =?= "Tesla V100S-PCIE-32GB"
queue 1
