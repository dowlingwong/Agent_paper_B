universe = docker
docker_image = cverstege/alma9-gridjob
executable = probe.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = probe.sh
+RequestWalltime = 1800
arguments = P7
output = P7.out
error = P7.err
log = P7.log
RequestCPUs = 2
RequestMemory = 4000
request_disk = 5000000
request_GPUs = 1
+RemoteJob = True
requirements = TARGET.CloudSite =?= "BwForCluster-Nemo2" && TARGET.GPUs_DeviceName =?= "NVIDIA H200"
queue 1
