universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:49dd9900e0bbb004fe1f45573583cf0cffeb9fe3d98f0ef6d3aa16fb4fe75949
executable = preflight.sh
arguments = $(ClusterId).$(ProcId) NVIDIA_A100-PCIE-40GB 8.0
requirements = (TARGET.GPUs_DeviceName =?= "NVIDIA A100-PCIE-40GB")
+RemoteJob = True
request_GPUs = 1
request_cpus = 8
request_memory = 131072
request_disk = 150000000
+RequestWalltime = 3600
periodic_hold = (NumJobStarts > 1)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
output = preflight.out
error = preflight.err
log = preflight_a100.log
transfer_input_files = PREFLIGHT_INPUTS.sha256,trackp_ada_v1.json,p4_probe_spec.json,D3_PREDECL_R4_20261127.md
transfer_output_files = handback
queue 1
