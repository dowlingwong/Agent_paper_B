# manifest_sha256 = a2e3a11b99aae62516ca345e33763b3f910e392bcb32892e347f3afb29171516
universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:69b06b35f093b4064525efa6fbd8bda48253f56f3b81baab6f21b7c93cc05296
executable = container_probe.sh
arguments = "CPROBE_TOPAS_V100S"
log = cprobe_topas_v100s.log
output = cprobe_topas_v100s.out
error = cprobe_topas_v100s.err
request_cpus = 2
request_memory = 8000
request_disk = 25000000
+RequestWalltime = 1800
request_GPUs = 1
+RemoteJob = True
requirements = (TARGET.GPUs_DeviceName =?= "Tesla V100S-PCIE-32GB")
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = container_probe.sh
queue 1
