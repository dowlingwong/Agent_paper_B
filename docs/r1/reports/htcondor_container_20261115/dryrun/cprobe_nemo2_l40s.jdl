# manifest_sha256 = 1ac809fe2c78a55ef4d0f5cd18bd6b6d540da32713fe59991da5e020ab6f0cc5
universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:69b06b35f093b4064525efa6fbd8bda48253f56f3b81baab6f21b7c93cc05296
executable = container_probe.sh
arguments = "CPROBE_NEMO2_L40S"
log = cprobe_nemo2_l40s.log
output = cprobe_nemo2_l40s.out
error = cprobe_nemo2_l40s.err
request_cpus = 2
request_memory = 8000
request_disk = 25000000
+RequestWalltime = 1800
request_GPUs = 1
+RemoteJob = True
requirements = (TARGET.GPUs_DeviceName =?= "NVIDIA L40S") && (TARGET.CloudSite =?= "BwForCluster-Nemo2")
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = container_probe.sh
queue 1
