    "diff_text": "--- a/train.py\n+++ b/train.py\n@@ -65,8 +65,18 @@\n     return optimizer, torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)\n \n \n+def augment(x):\n+    \"\"\"Random horizontal flip per image and one random shift of up to 4 pixels per batch.\"\"\"\n+    flip = torch.rand(x.shape[0], device=x.device) < 0.5\n+    x = torch.where(flip[:, None, None, None], x.flip(3), x)\n+    dy, dx = (int(v) for v in torch.randint(-4, 5, (2,)))\n+    padded = F.pad(x, (4, 4, 4, 4))\n+    h, w = x.shape[2], x.shape[3]\n+    return padded[:, :, 4 + dy:4 + dy + h, 4 + dx:4 + dx + w]\n+\n+\n def training_step(model, batch, step):\n-    return F.cross_entropy(model(preprocess(batch[\"x\"])), batch[\"y\"])\n+    return F.cross_entropy(model(augment(preprocess(batch[\"x\"]))), batch[\"y\"])\n \n \n def predict_logits(model, batch):\n",
