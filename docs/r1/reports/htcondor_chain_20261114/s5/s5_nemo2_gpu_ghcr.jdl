universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:69b06b35f093b4064525efa6fbd8bda48253f56f3b81baab6f21b7c93cc05296
executable = s5_run.sh
arguments = "$(ClusterId).$(ProcId)"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = s5_run.sh
transfer_output_files = s5_identity.txt, s5_env.txt, s5_nvidia.txt, s5_torch.txt, s5_llama.txt, s5_pull.txt, s5_PASSFAIL.txt
output = s5.out
error = s5.err
log = s5.log
+RequestWalltime = 1800
RequestCPUs = 2
RequestMemory = 8000
request_disk = 50000000
request_GPUs = 1
+RemoteJob = True
requirements = (TARGET.CloudSite =?= "BwForCluster-Nemo2") && (TARGET.GPUs_DeviceName =?= "NVIDIA L40S")
queue 1
