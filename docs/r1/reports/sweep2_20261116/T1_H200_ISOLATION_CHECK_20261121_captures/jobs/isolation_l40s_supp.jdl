# R1-T1-HOST-H200: SUPPLEMENTARY container host-condition check on one NEMO2 NVIDIA L40S (not the H200 host;
# labelled supplementary evidence only).  Sweep 2 pins NVIDIA H200, so this slot cannot be taken from it.
# Same v2 GPU image and same payload as the authoritative 1-GPU H200 job (cluster 759828).
universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:b1144ecec7ffe07642ff108fb9624aa34775cb873ed17f835ea3e3c87bc024fd
executable = run_checks.sh
arguments =
log = isolation_l40s_supp.log
output = isolation_l40s_supp.out
error = isolation_l40s_supp.err
request_cpus = 4
request_memory = 16000
request_disk = 20000000
request_GPUs = 1
+RequestWalltime = 1800
+RemoteJob = True
periodic_hold = (NumJobStarts > 1)
periodic_hold_reason = "no retry: a second start would need a fresh, explicitly reviewed submission (host-check policy)"
periodic_hold_subcode = 42
requirements = (TARGET.GPUs >= 1) && (TARGET.Arch == "X86_64") && (TARGET.OpSys == "LINUX") && (TARGET.Cpus >= 4) && (TARGET.GPUs_DeviceName =?= "NVIDIA L40S")
job_machine_attrs = CloudSite
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = isolation_payload.tar.gz
transfer_output_files = out
queue 1
