universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-cpu@sha256:c152c32980ccd708a9b5fda0a1da49b963064ebcbc608849406adf0c95bdf148
executable = s4_run.sh
arguments = "$(ClusterId).$(ProcId)"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = s4_run.sh
output = s4.out
error = s4.err
log = s4.log
+RequestWalltime = 3600
RequestCPUs = 2
RequestMemory = 8000
request_disk = 2000000
requirements = TARGET.ProvidesETPResources
queue 1
