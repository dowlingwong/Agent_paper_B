# S2-C2 sweep-2 chunk job (ENGINEERING; reviewed dry-run) — s2eng-20261116-a/digits_mlp-append_only_summary
universe = container
container_image = docker://ghcr.io/dowlingwong/r1-htc-gpu@sha256:69b06b35f093b4064525efa6fbd8bda48253f56f3b81baab6f21b7c93cc05296
executable = s2_c2_job.sh
arguments = s2_c2_spec.json
log = s2_c2_job.log
output = s2_c2_job.out
error = s2_c2_job.err
request_cpus = 16
request_memory = 128000
request_disk = 50000000
request_GPUs = 1
+RequestWalltime = 7200
+RemoteJob = True
requirements = (TARGET.CloudSite =?= "BwForCluster-Nemo2") && (TARGET.GPUs_DeviceName =?= "NVIDIA L40S") && (TARGET.Arch == "X86_64") && (TARGET.OpSys == "LINUX") && (TARGET.Cpus >= 16) && (regexp("^g36[0-9]{2}\.nemo\.privat$", TARGET.Machine))
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = s2_c2_job.sh,s2_c2_lib.py,s2_c2_spec.json
transfer_output_files = out,work,job_record.json,SHA256SUMS,llama-server.log
queue 1
