+# --- S2-C3 ENGINEERING replay shim (author row R1-S2C3-DRIVER; see S2_C3_DRIVER.md) --------------------
+# The unmodified B2 preflight binds the run to TASL-7: the Stage A authorization tables are read from absolute
+# /home/dowling/... paths and host_check/require_worker_host accept only the two approved exam hosts and their work
+# dirs.  This shim is inert unless the replay driver sets R1_S2C3_DECLARED_INPUTS.  In replay mode it only
+#   (a) resolves the declared Stage A table paths to sha-pinned copies shipped with the ENGINEERING replay job
+#       (same bytes: the copy's sha256 must equal the sha256 the B2 configuration binds), and
+#   (b) replaces the two TASL host/work-dir gates with "must not run on an approved exam host; out inside the
+#       declared job sandbox".
+# It touches no trial, manager, scoring or audit code; the authorization gates (committed config, note bytes, PLAN
+# rows, rule/b1-analysis digests, seed/host/gpu bindings) still run unchanged.
+def _s2c3_declared():
+    """The ENGINEERING replay declared-inputs manifest, or None outside replay mode (other phases unchanged)."""
+    path=os.environ.get('R1_S2C3_DECLARED_INPUTS')
+    if not path: return None
+    data=json.loads(Path(path).read_text())
+    if data.get('schema')!='s2_c3_declared_inputs/v1' or data.get('label')!='ENGINEERING_ONLY':
+        raise RuntimeError('STOP: S2-C3 replay declared-inputs manifest is invalid')
+    return data
+
+
+def _s2c3_relocate(cfg, key, path):
+    """Replay mode: resolve a TASL-absolute authorization input to its declared, sha-pinned copy."""
+    data=_s2c3_declared()
+    if data is None: return path
+    item_id=(data.get('stage_a_inputs') or {}).get(key)
+    if not item_id: return path
+    root=os.environ.get('R1_S2C3_DECLARED_ROOT')
+    item=next((row for row in data.get('items',[]) if row.get('id')==item_id), None)
+    if item is None or not root: raise RuntimeError(f'STOP: S2-C3 replay declared input {key} is not declared')
+    relocated=Path(root)/item.get('staged', item.get('path',''))
+    want=cfg.get(key+'_sha256')
+    if not isinstance(want,str) or digest_file(relocated)!=want:
+        raise RuntimeError(f'STOP: S2-C3 replay declared input {key} sha256 mismatch')
+    return relocated
+
+
+def _s2c3_host_check(out):
+    """Replay-mode replacement for the TASL host/work-dir gate: off-TASL and inside the declared sandbox."""
+    node=platform.node().split('.')[0]
+    if node.casefold() in {host.casefold() for host in APPROVED_EXAM_HOSTS}:
+        raise RuntimeError('STOP: S2-C3 replay is an L40S deployment check and must not run on an approved exam host')
+    root=os.environ.get('R1_S2C3_SANDBOX_ROOT')
+    if not root: raise RuntimeError('STOP: S2-C3 replay sandbox root is not declared')
+    if not Path(out).resolve().is_relative_to(Path(root).resolve()):
+        raise RuntimeError('STOP: S2-C3 replay output escapes the declared sandbox root')
+
+
+def _s2c3_require_worker_host(job, node=None):
+    """Replay-mode replacement for require_worker_host: same off-TASL + sandbox check, returns the real node."""
+    _s2c3_host_check(job.get('out',''))
+    return (node if node is not None else platform.node()).split('.')[0]
+
+
 def host_check(cfg, out):
+    if _s2c3_declared() is not None:
+        _s2c3_host_check(out); return
